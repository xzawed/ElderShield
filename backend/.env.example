DATABASE_URL=sqlite:///./eldershield.db
# Required for startup (must differ; must not be change-me-*)
ADMIN_API_KEY=replace-with-strong-admin-key
DEVICE_API_KEY=replace-with-strong-device-key
# Local-only escape hatch (never in production):
# ELDERSHIELD_ALLOW_INSECURE_DEFAULTS=1
# Lab enroll without Play Integrity (requires ALLOW_INSECURE_DEFAULTS=1):
# ELDERSHIELD_ENROLL_SKIP_INTEGRITY=1
# ENROLL_MAX_PER_WINDOW=10
# ENROLL_RATE_LIMIT_PER_MINUTE=20
# Production Play Integrity decode (fail-closed unless both set + ADC credentials):
# PLAY_INTEGRITY_ENABLED=1
# PLAY_PACKAGE_NAME=com.eldershield
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/play-integrity-sa.json
# pip install -r requirements-integrity.txt

# Optional — dedicated NextDNS profile for country DNS/internet policy
# (see docs/runbooks/nextdns-setup.md):
# NEXTDNS_API_KEY=
# NEXTDNS_PROFILE_ID=
# Optional — Phase 2A admin notify (Telegram/Slack-compatible webhook POST {text}):
# ADMIN_NOTIFY_WEBHOOK_URL=
# Production Admin UI cookie:
# COOKIE_SECURE=1
