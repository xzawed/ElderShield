DATABASE_URL=sqlite:///./eldershield.db
# Required for startup (must differ; must not be change-me-*)
ADMIN_API_KEY=replace-with-strong-admin-key
DEVICE_API_KEY=replace-with-strong-device-key
# Local-only escape hatch (never in production):
# ELDERSHIELD_ALLOW_INSECURE_DEFAULTS=1
# Optional — dedicated NextDNS profile for country DNS/internet policy
# (see docs/runbooks/nextdns-setup.md):
# NEXTDNS_API_KEY=
# NEXTDNS_PROFILE_ID=
